---
import '../styles/global.css';
import LanguageSwitch from '../components/LanguageSwitch.astro';
import { locales, type Locale } from '../i18n/languages';
import { t } from '../i18n/ui';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  width?: 'default' | 'wide';
}

const { locale, title, description, width = 'default' } = Astro.props;
const contentWidth = width === 'wide' ? 'max-w-6xl' : 'max-w-5xl';
const pageTitle = title ?? t(locale, 'site.title');
const pageDescription = description ?? t(locale, 'site.tagline');

const base = import.meta.env.BASE_URL;
const { pathname } = Astro.url;
const withoutBase = pathname.startsWith(base) ? pathname.slice(base.length) : pathname;
const segments = withoutBase.split('/').filter(Boolean);
const rest = segments.slice(1).join('/');
const restWithTrailingSlash = rest ? `${rest}/` : '';

const canonicalUrl = new URL(pathname, Astro.site).href;
const alternateUrls = locales.map((loc) => ({
  locale: loc,
  href: new URL(`${base}/${loc}/${restWithTrailingSlash}`, Astro.site).href,
}));
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalUrl} />
    {alternateUrls.map((alt) => <link rel="alternate" hreflang={alt.locale} href={alt.href} />)}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body class="min-h-screen bg-surface font-sans text-default antialiased">
    <header class="fixed top-0 right-0 left-0 z-50">
      <div id="header-surface" class="header-surface absolute inset-0" data-scrolled="false"></div>

      <div class="relative mx-auto max-w-5xl px-4">
        <div class="flex h-16 items-center justify-between">
          <a
            href={`${import.meta.env.BASE_URL}/${locale}/`}
            class="shrink-0 text-lg font-semibold tracking-tight text-strong transition-colors duration-[var(--duration-fast)] hover:text-muted"
          >
            linuxxing
          </a>
          <div class="flex items-center gap-4">
            <a
              href={`${import.meta.env.BASE_URL}/${locale}/commands/`}
              class="text-sm font-medium text-muted transition-colors duration-[var(--duration-fast)] hover:text-strong"
            >
              {t(locale, 'nav.commands')}
            </a>
            <a
              href={`${import.meta.env.BASE_URL}/${locale}/lab/`}
              class="text-sm font-medium text-muted transition-colors duration-[var(--duration-fast)] hover:text-strong"
            >
              {t(locale, 'nav.lab')}
            </a>
            <a
              href={`${import.meta.env.BASE_URL}/${locale}/study/`}
              class="text-sm font-medium text-muted transition-colors duration-[var(--duration-fast)] hover:text-strong"
            >
              {t(locale, 'nav.study')}
            </a>
            <LanguageSwitch />
          </div>
        </div>
      </div>
    </header>

    <div class="h-16"></div>

    <main class:list={['mx-auto px-4 pb-24 pt-10', contentWidth]}>
      <slot />
    </main>

    <footer class="mx-auto max-w-5xl px-4 pb-10">
      <hr class="rule mb-6" />
      <div class="flex flex-wrap items-center justify-between gap-3 text-sm text-muted">
        <p>{t(locale, 'footer.tagline')}</p>
        <a
          href="https://github.com/criskell/linuxxing"
          class="eyebrow interactive rounded-md px-2 py-1 text-muted hover:text-strong"
        >
          {t(locale, 'footer.source')}
        </a>
      </div>
    </footer>

    <script>
      const surface = document.getElementById('header-surface')!;
      const enterThreshold = 12;
      const leaveThreshold = 4;

      let scrolled = false;
      let ticking = false;

      const syncSurface = () => {
        ticking = false;
        const offset = window.scrollY;
        const next = scrolled ? offset > leaveThreshold : offset > enterThreshold;
        if (next === scrolled) return;
        scrolled = next;
        surface.dataset.scrolled = String(scrolled);
      };

      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(syncSurface);
      };

      syncSurface();
      window.addEventListener('scroll', onScroll, { passive: true });
    </script>
  </body>
</html>
