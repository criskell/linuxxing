---
import type { Locale } from '../i18n/languages';
import { t } from '../i18n/ui';

interface Props {
  locale: Locale;
  commandName: string;
  flags: string[];
}

const { locale, commandName, flags } = Astro.props;
---

<div class="flex flex-col gap-3" data-command-name={commandName}>
  <div>
    <h2 class="eyebrow">{t(locale, 'commands.builderHeading')}</h2>
    <p class="mt-1 text-sm text-muted">{t(locale, 'commands.builderHint')}</p>
  </div>
  <div class="flex flex-wrap gap-2">
    {
      flags.map((flag) => (
        <button
          type="button"
          data-flag={flag}
          aria-pressed="false"
          class="flag-toggle interactive rounded-md border border-hairline bg-surface-raised px-3 py-1.5 font-mono text-xs text-muted hover:text-default aria-pressed:border-accent aria-pressed:bg-accent aria-pressed:text-on-accent"
        >
          {flag}
        </button>
      ))
    }
  </div>
</div>

<script>
  const LINUXXING_SET_COMMAND = 'linuxxing:set-command';

  document.querySelectorAll<HTMLElement>('[data-command-name]').forEach((builder) => {
    const commandName = builder.dataset.commandName!;
    const toggles = Array.from(builder.querySelectorAll<HTMLButtonElement>('.flag-toggle'));

    const emitCommand = () => {
      const activeFlags = toggles.filter((toggle) => toggle.getAttribute('aria-pressed') === 'true');
      const parts = [commandName, ...activeFlags.map((toggle) => toggle.dataset.flag)];
      document.dispatchEvent(new CustomEvent(LINUXXING_SET_COMMAND, { detail: parts.join(' ') }));
    };

    toggles.forEach((toggle) => {
      toggle.addEventListener('click', () => {
        const pressed = toggle.getAttribute('aria-pressed') === 'true';
        toggle.setAttribute('aria-pressed', pressed ? 'false' : 'true');
        emitCommand();
      });
    });
  });
</script>
