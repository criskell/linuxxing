---
import { locales, type Locale } from '../i18n/languages';

const base = import.meta.env.BASE_URL;
const { pathname } = Astro.url;
const withoutBase = pathname.startsWith(base) ? pathname.slice(base.length) : pathname;
const segments = withoutBase.split('/').filter(Boolean);
const currentLocale = (segments[0] as Locale) ?? 'en';
const rest = segments.slice(1).join('/');
---

<div class="inline-flex gap-0.5 rounded-md border border-hairline bg-surface-raised p-0.5">
  {locales.map((loc) => (
    <a
      href={`${base}/${loc}/${rest}`}
      aria-current={loc === currentLocale ? 'page' : undefined}
      class:list={[
        'rounded-sm px-2.5 py-1 font-mono text-2xs font-medium transition-colors duration-[var(--duration-fast)]',
        loc === currentLocale
          ? 'bg-accent text-on-accent'
          : 'text-muted hover:text-strong',
      ]}
    >
      {loc.toUpperCase()}
    </a>
  ))}
</div>
