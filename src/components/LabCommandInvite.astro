---
import type { Locale } from '../i18n/languages';
import { t } from '../i18n/ui';
import { SANDBOX_ITEMS, sandboxIntro } from '../lib/lab/sandbox';

interface Props {
  locale: Locale;
  commandName: string;
}

const { locale, commandName } = Astro.props;
---

<div class="surface flex flex-col gap-4 p-5">
  <p class="eyebrow">{t(locale, 'lab.practiceHeading')}</p>
  <p class="text-sm leading-relaxed text-default">{sandboxIntro[locale]}</p>

  <ul class="flex flex-col gap-1.5">
    {
      SANDBOX_ITEMS.map((item) => (
        <li class="grid grid-cols-[9rem_minmax(0,1fr)] gap-3 text-sm">
          <span class="data text-xs text-strong">{item.name}</span>
          <span class="text-muted">{item.note[locale]}</span>
        </li>
      ))
    }
  </ul>

  <a
    href={`${import.meta.env.BASE_URL}/${locale}/lab/?command=${encodeURIComponent(commandName)}`}
    class="chip chip-info interactive w-fit px-3 py-1.5"
  >
    {t(locale, 'lab.openWithCommand')(commandName)}
  </a>
</div>
