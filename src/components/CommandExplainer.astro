---
import type { Locale } from '../i18n/languages';
import { t } from '../i18n/ui';
import { analyzeScript, type StepType } from '../lib/analyze';

interface Props {
  locale: Locale;
  initialCommand: string;
}

const { locale, initialCommand } = Astro.props;

const initialSteps = analyzeScript(initialCommand, locale);

const TYPE_LABEL_KEY: Record<StepType, Parameters<typeof t>[1]> = {
  command: 'type.command',
  subcommand: 'type.subcommand',
  'flag-long': 'type.flag-long',
  'flag-short': 'type.flag-short',
  arg: 'type.arg',
  unknown: 'type.unknown',
  comment: 'type.comment',
  control: 'type.control',
  test: 'type.test',
  operator: 'type.operator',
  redirect: 'type.redirect',
  assignment: 'type.assignment',
  substitution: 'type.substitution',
  variable: 'type.variable',
};
---

<div data-locale={locale} class="flex flex-col gap-5">
  <p class="text-sm text-muted">{t(locale, 'commands.tryItPrompt')}</p>

  <div class="flex flex-col gap-3">
    <div
      class="relative rounded-lg border border-hairline bg-surface-nested focus-within:border-accent focus-within:ring-2 focus-within:ring-accent-quiet"
    >
      <pre
        id="highlight-layer"
        aria-hidden="true"
        class="pointer-events-none m-0 min-h-12 whitespace-pre-wrap break-words px-4 py-3.5 font-mono text-sm leading-relaxed text-default">
      </pre>
      <textarea
        id="cmd-input"
        rows="1"
        spellcheck="false"
        autocomplete="off"
        class="absolute inset-0 resize-none whitespace-pre-wrap break-words bg-transparent px-4 py-3.5 font-mono text-sm leading-relaxed text-transparent caret-[var(--text-strong)] outline-none placeholder:text-faint"
        set:text={initialCommand}
      />
    </div>
    <div class="flex justify-end">
      <button
        id="explain-btn"
        class="rounded-lg bg-accent px-6 py-3.5 text-sm font-semibold text-on-accent transition-colors duration-[var(--duration-fast)] hover:bg-accent-hover"
      >
        {t(locale, 'input.button')}
      </button>
    </div>
  </div>

  <div id="steps" class="flex flex-col gap-3">
    {
      initialSteps.map((s, i) => (
        <div class="surface flex gap-3.5 p-4" style={`border-left: 3px solid var(--color-${s.type})`}>
          <div class="min-w-5 pt-0.5 font-mono text-xs font-semibold text-faint">{i + 1}</div>
          <div class="flex-1">
            <div class="mb-1.5 flex flex-wrap items-baseline gap-2.5">
              <span class="font-mono text-base font-bold" style={`color: var(--color-${s.type})`}>
                {s.token}
              </span>
              <span
                class="chip"
                style={`background: var(--color-${s.type}-fill); border-color: color-mix(in oklab, var(--color-${s.type}) 32%, transparent); color: var(--color-${s.type})`}
              >
                {t(locale, TYPE_LABEL_KEY[s.type])}
              </span>
            </div>
            <div class="text-sm leading-relaxed text-default">{s.desc}</div>
          </div>
        </div>
      ))
    }
  </div>
</div>

<script>
  import { analyzeScript, highlightScript, type Step, type StepType } from '../lib/analyze';
  import { t } from '../i18n/ui';
  import type { Locale } from '../i18n/languages';

  const root = document.querySelector<HTMLElement>('[data-locale]')!;
  const locale = root.dataset.locale as Locale;

  const input = document.getElementById('cmd-input') as HTMLTextAreaElement;
  const highlightLayer = document.getElementById('highlight-layer')!;
  const btn = document.getElementById('explain-btn') as HTMLButtonElement;
  const stepsEl = document.getElementById('steps')!;

  const TYPE_LABEL_KEY: Record<StepType, Parameters<typeof t>[1]> = {
    command: 'type.command',
    subcommand: 'type.subcommand',
    'flag-long': 'type.flag-long',
    'flag-short': 'type.flag-short',
    arg: 'type.arg',
    unknown: 'type.unknown',
    comment: 'type.comment',
    control: 'type.control',
    test: 'type.test',
    operator: 'type.operator',
    redirect: 'type.redirect',
    assignment: 'type.assignment',
    substitution: 'type.substitution',
    variable: 'type.variable',
  };

  function colorVar(type: StepType) {
    return `var(--color-${type})`;
  }

  function fillVar(type: StepType) {
    return `var(--color-${type}-fill)`;
  }

  function escapeHtml(str: string) {
    const div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
  }

  function renderHighlight() {
    const spans = highlightScript(input.value);
    highlightLayer.innerHTML = spans
      .map((s) =>
        s.type ? `<span style="color:${colorVar(s.type)}">${escapeHtml(s.text)}</span>` : escapeHtml(s.text),
      )
      .join('');
  }

  function render(command: string) {
    const steps: Step[] = analyzeScript(command, locale);
    if (!steps.length) return;

    stepsEl.innerHTML = '';
    steps.forEach((s, i) => {
      const el = document.createElement('div');
      el.className = 'surface flex gap-3.5 p-4';
      el.style.borderLeft = `3px solid ${colorVar(s.type)}`;
      el.innerHTML = `
        <div class="min-w-5 pt-0.5 font-mono text-xs font-semibold text-faint">${i + 1}</div>
        <div class="flex-1">
          <div class="mb-1.5 flex flex-wrap items-baseline gap-2.5">
            <span class="font-mono text-base font-bold" style="color:${colorVar(s.type)}">${escapeHtml(s.token)}</span>
            <span class="chip" style="background:${fillVar(s.type)};border-color:color-mix(in oklab, ${colorVar(s.type)} 32%, transparent);color:${colorVar(s.type)}">${t(locale, TYPE_LABEL_KEY[s.type])}</span>
          </div>
          <div class="text-sm leading-relaxed text-default">${escapeHtml(s.desc)}</div>
        </div>
      `;
      stepsEl.appendChild(el);
    });
  }

  function runExplain() {
    const value = input.value.trim();
    if (!value) return;
    render(value);
  }

  input.addEventListener('input', renderHighlight);
  btn.addEventListener('click', runExplain);
  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && (e.metaKey || e.ctrlKey)) {
      e.preventDefault();
      runExplain();
    }
  });

  document.addEventListener('linuxxing:set-command', (e) => {
    input.value = (e as CustomEvent<string>).detail;
    renderHighlight();
    runExplain();
  });

  renderHighlight();
</script>
