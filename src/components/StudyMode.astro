---
import type { Locale } from '../i18n/languages';
import { t } from '../i18n/ui';
import { STUDY_TOPICS, STUDY_CARDS } from '../lib/study/registry';
import { labTracksForObjective } from '../lib/lab/objectives';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const cardsForTopic = (topicId: string) => STUDY_CARDS.filter((card) => card.topic === topicId);
---

<div data-locale={locale} class="flex flex-col gap-10">
  <div class="flex flex-col gap-4">
    <p class="text-sm text-muted">{t(locale, 'study.totalCards')(STUDY_CARDS.length)}</p>

    <label class="flex w-fit items-center gap-2 text-sm text-muted">
      <input type="checkbox" id="filter-due-toggle" class="h-4 w-4 rounded border-hairline" />
      {t(locale, 'study.filterDue')}
    </label>

    <div class="grid gap-2 sm:grid-cols-2 lg:grid-cols-5">
      {
        STUDY_TOPICS.map((topic) => (
          <a
            href={`#${topic.id}`}
            class="interactive flex flex-col gap-1 rounded-md border border-hairline bg-surface-raised px-3 py-2"
          >
            <span class="eyebrow">LPIC-1 {topic.objectiveCode}</span>
            <span class="text-xs text-default">{topic.title[locale]}</span>
          </a>
        ))
      }
    </div>
  </div>

  {
    STUDY_TOPICS.map((topic) => (
      <section id={topic.id} class="flex scroll-mt-24 flex-col gap-4">
        <div class="flex flex-wrap items-baseline justify-between gap-3 border-b border-hairline pb-2">
          <div class="flex items-baseline gap-3">
            <p class="eyebrow">LPIC-1 {topic.objectiveCode}</p>
            <h2 class="text-lg font-semibold text-strong">{topic.title[locale]}</h2>
          </div>
          <div class="flex flex-wrap gap-2">
            {labTracksForObjective(topic.objectiveCode).map((track) => (
              <a
                href={`${import.meta.env.BASE_URL}/${locale}/lab/#${track.id}`}
                class="chip chip-info interactive px-3 py-1"
              >
                {track.title[locale]}
              </a>
            ))}
          </div>
        </div>

        <div class="flex flex-col gap-4">
          {cardsForTopic(topic.id).map((card) => (
            <article class="surface flex flex-col gap-3 p-5" data-card-block={card.id}>
              <a
                href={`${import.meta.env.BASE_URL}/${locale}/study/${card.id}/`}
                class="interactive w-fit font-semibold text-strong hover:text-muted"
              >
                {card.front[locale]}
              </a>
              <p class="text-sm leading-relaxed text-default">{card.back[locale]}</p>

              <div class="mt-1 flex flex-wrap items-center justify-between gap-3 border-t border-hairline pt-3">
                <span class="chip chip-caution hidden" data-due-badge>
                  {t(locale, 'study.dueBadge')}
                </span>
                <div class="flex flex-wrap gap-2">
                  <button
                    type="button"
                    data-grade="again"
                    data-card-id={card.id}
                    class="chip chip-negative interactive px-3 py-1.5"
                  >
                    {t(locale, 'study.grade.again')}
                  </button>
                  <button
                    type="button"
                    data-grade="hard"
                    data-card-id={card.id}
                    class="chip chip-caution interactive px-3 py-1.5"
                  >
                    {t(locale, 'study.grade.hard')}
                  </button>
                  <button
                    type="button"
                    data-grade="good"
                    data-card-id={card.id}
                    class="chip chip-info interactive px-3 py-1.5"
                  >
                    {t(locale, 'study.grade.good')}
                  </button>
                  <button
                    type="button"
                    data-grade="easy"
                    data-card-id={card.id}
                    class="chip chip-positive interactive px-3 py-1.5"
                  >
                    {t(locale, 'study.grade.easy')}
                  </button>
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>
    ))
  }
</div>

<script>
  import { STUDY_CARDS } from '../lib/study/registry';
  import { loadProgress, saveProgress, type StudyProgress } from '../lib/study-progress';
  import { scheduleReview, createInitialReviewState, isDue, type ReviewGrade } from '../lib/spaced-repetition';

  let progress: StudyProgress = loadProgress();

  const filterToggle = document.getElementById('filter-due-toggle') as HTMLInputElement;

  const updateCardView = () => {
    STUDY_CARDS.forEach((card) => {
      const block = document.querySelector<HTMLElement>(`[data-card-block="${card.id}"]`);
      if (!block) return;

      const due = isDue(progress[card.id]);
      block.querySelector<HTMLElement>('[data-due-badge]')?.classList.toggle('hidden', !due);
      block.classList.toggle('hidden', filterToggle.checked && !due);
    });
  };

  document.addEventListener('click', (event) => {
    const target = (event.target as HTMLElement).closest<HTMLElement>('[data-grade]');
    if (!target) return;

    const cardId = target.dataset.cardId!;
    const grade = target.dataset.grade as ReviewGrade;
    const currentState = progress[cardId] ?? createInitialReviewState();
    progress = { ...progress, [cardId]: scheduleReview(currentState, grade) };
    saveProgress(progress);
    updateCardView();
  });

  filterToggle.addEventListener('change', updateCardView);

  updateCardView();
</script>
