---
import type { Locale } from '../i18n/languages';
import { t } from '../i18n/ui';
import { LAB_TRACKS, LAB_EXERCISES } from '../lib/lab/registry';
import { SANDBOX_ITEMS, sandboxIntro } from '../lib/lab/sandbox';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const exercisesForTrack = (trackId: string) => LAB_EXERCISES.filter((exercise) => exercise.track === trackId);
---

<div data-lab data-locale={locale} class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] lg:items-start">
  <section class="surface order-1 flex min-w-0 flex-col gap-4 p-4 lg:sticky lg:top-20 lg:order-2">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <p class="text-sm font-medium text-strong" data-machine-status>{t(locale, 'lab.idleTerminal')}</p>
      <div class="flex gap-2">
        <button type="button" data-boot class="chip chip-info interactive px-3 py-1.5">
          {t(locale, 'lab.boot')}
        </button>
        <button type="button" data-restart hidden class="chip chip-neutral interactive px-3 py-1.5">
          {t(locale, 'lab.restart')}
        </button>
      </div>
    </div>

    <div class="terminal-frame" data-terminal-frame>
      <p class="p-4 text-sm text-muted" data-terminal-placeholder>{t(locale, 'lab.idleTerminal')}</p>
      <div class="h-full w-full" data-terminal></div>
    </div>

    <div class="flex flex-col gap-3 border-t border-hairline pt-4">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <p class="text-sm font-medium text-strong">{t(locale, 'lab.sandboxHeading')}</p>
        <button type="button" data-prepare-sandbox class="chip chip-neutral interactive px-3 py-1.5">
          {t(locale, 'lab.prepareSandbox')}
        </button>
      </div>

      <details class="text-sm">
        <summary class="cursor-pointer text-muted">{t(locale, 'lab.sandboxWhatIsInside')}</summary>
        <p class="mt-2 text-sm text-muted">{sandboxIntro[locale]}</p>
        <ul class="mt-2 flex flex-col gap-1">
          {
            SANDBOX_ITEMS.map((item) => (
              <li class="grid grid-cols-[9rem_minmax(0,1fr)] gap-2 text-sm">
                <span class="data text-xs text-strong">{item.name}</span>
                <span class="text-muted">{item.note[locale]}</span>
              </li>
            ))
          }
        </ul>
      </details>

      <p class="hidden text-sm leading-relaxed" data-sandbox-result></p>
    </div>
  </section>

  <section class="order-2 flex min-w-0 flex-col gap-6 lg:order-1">
    <div class="flex flex-col gap-4">
      <div class="flex items-baseline justify-between gap-3">
        <h2 class="text-lg font-semibold text-strong">{t(locale, 'lab.exercisesHeading')}</h2>
        <p class="text-sm text-muted" data-lab-progress>{t(locale, 'lab.progress')(0, LAB_EXERCISES.length)}</p>
      </div>

      <label class="flex w-fit items-center gap-2 text-sm text-muted">
        <input type="checkbox" data-filter-unsolved class="h-4 w-4 rounded border-hairline" />
        {t(locale, 'lab.filterUnsolved')}
      </label>

      <div class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
        {
          LAB_TRACKS.map((track) => (
            <a
              href={`#${track.id}`}
              class="interactive flex flex-col gap-1 rounded-md border border-hairline bg-surface-raised px-3 py-2"
            >
              <span class="eyebrow">LPIC-1 {track.objectiveCode}</span>
              <span class="text-sm text-default">{track.title[locale]}</span>
              <span class="text-xs text-faint" data-track-count={track.id} />
            </a>
          ))
        }
      </div>
    </div>

    {
      LAB_TRACKS.map((track) => (
        <div id={track.id} class="flex scroll-mt-24 flex-col gap-3">
          <div class="flex items-baseline gap-3 border-b border-hairline pb-2">
            <p class="eyebrow">LPIC-1 {track.objectiveCode}</p>
            <h3 class="text-base font-semibold text-strong">{track.title[locale]}</h3>
          </div>

          {exercisesForTrack(track.id).map((exercise) => (
            <details class="surface" data-exercise={exercise.id}>
              <summary class="flex cursor-pointer flex-wrap items-center gap-3 px-5 py-4">
                <span class="font-semibold text-strong">{exercise.title[locale]}</span>
                <span class="chip chip-positive hidden" data-solved-badge>
                  {t(locale, 'lab.solved')}
                </span>
              </summary>

              <div class="flex flex-col gap-5 border-t border-hairline p-5">
                <p class="leading-relaxed text-default">{exercise.task[locale]}</p>

                <div class="flex flex-col gap-2">
                  <p class="eyebrow">{t(locale, 'lab.criteriaHeading')}</p>
                  <ul class="flex flex-col gap-1.5">
                    {exercise.checks.map((check, index) => (
                      <li class="flex items-baseline gap-2 text-sm text-muted" data-check-row={index}>
                        <span class="data w-4 shrink-0 text-center text-faint" data-check-mark>
                          ·
                        </span>
                        <span>{check.label[locale]}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <div class="flex flex-wrap gap-2">
                  <button type="button" data-prepare class="chip chip-neutral interactive px-3 py-1.5">
                    {t(locale, 'lab.prepare')}
                  </button>
                  <button type="button" data-check class="chip chip-info interactive px-3 py-1.5">
                    {t(locale, 'lab.check')}
                  </button>
                </div>

                <p class="hidden text-sm leading-relaxed" data-result />

                <div class="flex flex-col gap-3 border-t border-hairline pt-4">
                  <details class="text-sm">
                    <summary class="eyebrow cursor-pointer">{t(locale, 'lab.hint')}</summary>
                    <p class="mt-2 text-sm leading-relaxed text-muted">{exercise.hint[locale]}</p>
                  </details>

                  <details class="text-sm">
                    <summary class="eyebrow cursor-pointer">{t(locale, 'lab.solution')}</summary>
                    <div class="mt-2 flex flex-col items-start gap-2">
                      <code class="surface-nested data block w-full overflow-x-auto p-3 text-xs text-default">
                        {exercise.solutionCommand}
                      </code>
                      <button type="button" data-type-solution class="chip chip-neutral interactive px-3 py-1.5">
                        {t(locale, 'lab.typeSolution')}
                      </button>
                    </div>
                  </details>
                </div>
              </div>
            </details>
          ))}
        </div>
      ))
    }
  </section>
</div>

<style>
  [data-exercise] > summary::-webkit-details-marker {
    display: none;
  }

  [data-exercise] > summary::after {
    color: var(--text-faint);
    content: '\25b8';
    font-size: var(--step-xs);
    margin-left: auto;
    transition: transform var(--duration-fast) var(--ease-standard);
  }

  [data-exercise][open] > summary::after {
    transform: rotate(90deg);
  }

  .terminal-frame {
    background-color: #fbfbfb;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-md);
    height: 26rem;
    overflow: hidden;
    padding: 0.5rem;
  }
</style>

<script>
  import '@xterm/xterm/css/xterm.css';
  import { LabMachine, type MachineStatus } from '../lib/lab/machine';
  import { LAB_TRACKS, LAB_EXERCISES } from '../lib/lab/registry';
  import { SANDBOX_SETUP } from '../lib/lab/sandbox';
  import { loadLabProgress, saveLabProgress } from '../lib/lab/progress';
  import { t } from '../i18n/ui';
  import type { Locale } from '../i18n/languages';

  const root = document.querySelector<HTMLElement>('[data-lab]')!;
  const locale = root.dataset.locale as Locale;

  const statusLabel = root.querySelector<HTMLElement>('[data-machine-status]')!;
  const bootButton = root.querySelector<HTMLButtonElement>('[data-boot]')!;
  const restartButton = root.querySelector<HTMLButtonElement>('[data-restart]')!;
  const sandboxButton = root.querySelector<HTMLButtonElement>('[data-prepare-sandbox]')!;
  const sandboxResult = root.querySelector<HTMLElement>('[data-sandbox-result]')!;
  const terminalFrame = root.querySelector<HTMLElement>('[data-terminal-frame]')!;
  const terminalContainer = root.querySelector<HTMLElement>('[data-terminal]')!;
  const placeholder = root.querySelector<HTMLElement>('[data-terminal-placeholder]')!;
  const progressLabel = root.querySelector<HTMLElement>('[data-lab-progress]')!;
  const filterToggle = root.querySelector<HTMLInputElement>('[data-filter-unsolved]')!;

  const requestedCommand = new URLSearchParams(window.location.search).get('command');

  let progress = loadLabProgress();

  const findExercise = (id: string) => LAB_EXERCISES.find((exercise) => exercise.id === id)!;

  const showStatus = (status: MachineStatus) => {
    if (status === 'booting') statusLabel.textContent = t(locale, 'lab.booting');
    if (status === 'ready') {
      statusLabel.textContent = t(locale, 'lab.ready');
      restartButton.hidden = false;
    }
  };

  const machine = new LabMachine({
    assetsPath: `${import.meta.env.BASE_URL}/lab`,
    terminalContainer,
    banner: t(locale, 'lab.terminalBanner'),
    onStatusChange: showStatus,
    onDownloadProgress: (percent) => {
      statusLabel.textContent = t(locale, 'lab.downloading')(percent);
    },
  });

  const tones = {
    positive: 'text-sm leading-relaxed text-positive',
    negative: 'text-sm leading-relaxed text-negative',
    muted: 'text-sm leading-relaxed text-muted',
  };

  const showMessage = (target: HTMLElement, message: string, tone: keyof typeof tones) => {
    target.textContent = message;
    target.className = tones[tone];
  };

  const showResult = (block: HTMLElement, message: string, tone: keyof typeof tones) =>
    showMessage(block.querySelector<HTMLElement>('[data-result]')!, message, tone);

  const checkMarks = {
    pending: { mark: '·', markClass: 'data w-4 shrink-0 text-center text-faint', rowClass: 'text-muted' },
    passed: { mark: '✓', markClass: 'data w-4 shrink-0 text-center text-positive', rowClass: 'text-default' },
    failed: { mark: '✗', markClass: 'data w-4 shrink-0 text-center text-negative', rowClass: 'text-negative' },
  };

  const markCheck = (block: HTMLElement, index: number, state: keyof typeof checkMarks) => {
    const row = block.querySelector<HTMLElement>(`[data-check-row="${index}"]`);
    if (!row) return;
    const { mark, markClass, rowClass } = checkMarks[state];
    row.className = `flex items-baseline gap-2 text-sm ${rowClass}`;
    const marker = row.querySelector<HTMLElement>('[data-check-mark]')!;
    marker.textContent = mark;
    marker.className = markClass;
  };

  const resetChecks = (block: HTMLElement, total: number) => {
    for (let index = 0; index < total; index += 1) markCheck(block, index, 'pending');
  };

  const renderProgress = () => {
    const solved = LAB_EXERCISES.filter((exercise) => progress[exercise.id]).length;
    progressLabel.textContent = t(locale, 'lab.progress')(solved, LAB_EXERCISES.length);

    LAB_TRACKS.forEach((track) => {
      const trackExercises = LAB_EXERCISES.filter((exercise) => exercise.track === track.id);
      const trackSolved = trackExercises.filter((exercise) => progress[exercise.id]).length;
      const counter = root.querySelector<HTMLElement>(`[data-track-count="${track.id}"]`);
      if (counter) counter.textContent = t(locale, 'lab.trackProgress')(trackSolved, trackExercises.length);
    });

    LAB_EXERCISES.forEach((exercise) => {
      const block = root.querySelector<HTMLElement>(`[data-exercise="${exercise.id}"]`);
      if (!block) return;
      const isSolved = Boolean(progress[exercise.id]);
      block.querySelector<HTMLElement>('[data-solved-badge]')?.classList.toggle('hidden', !isSolved);
      block.hidden = filterToggle.checked && isSolved;
    });
  };

  const prepareSandbox = async () => {
    const exitCode = await machine.run(SANDBOX_SETUP);
    if (exitCode === null) {
      showMessage(sandboxResult, t(locale, 'lab.needsBoot'), 'muted');
      return false;
    }
    showMessage(sandboxResult, t(locale, 'lab.sandboxReady'), 'muted');
    return true;
  };

  const runChecks = async (block: HTMLElement, exercise: (typeof LAB_EXERCISES)[number]) => {
    let passed = 0;
    for (const [index, check] of exercise.checks.entries()) {
      const exitCode = await machine.run(check.command);
      if (exitCode === null) return null;
      markCheck(block, index, exitCode === 0 ? 'passed' : 'failed');
      if (exitCode === 0) passed += 1;
    }
    return passed;
  };

  bootButton.addEventListener('click', async () => {
    bootButton.disabled = true;
    placeholder.hidden = true;
    await machine.boot();
    bootButton.hidden = true;

    if (requestedCommand) {
      await prepareSandbox();
      machine.typeIntoShell(`${requestedCommand} `);
    }
    machine.focus();
  });

  restartButton.addEventListener('click', () => machine.restart());

  sandboxButton.addEventListener('click', async () => {
    const prepared = await prepareSandbox();
    if (prepared && requestedCommand) machine.typeIntoShell(`${requestedCommand} `);
    machine.focus();
  });

  filterToggle.addEventListener('change', renderProgress);

  root.querySelectorAll<HTMLDetailsElement>('[data-exercise]').forEach((block) => {
    block.addEventListener('toggle', () => {
      if (!block.open) return;
      root.querySelectorAll<HTMLDetailsElement>('[data-exercise]').forEach((other) => {
        if (other !== block) other.open = false;
      });
    });
  });

  root.addEventListener('click', async (event) => {
    const trigger = (event.target as HTMLElement).closest<HTMLElement>(
      '[data-prepare], [data-check], [data-type-solution]',
    );
    if (!trigger) return;

    const block = trigger.closest<HTMLElement>('[data-exercise]')!;
    const exercise = findExercise(block.dataset.exercise!);

    if (trigger.hasAttribute('data-prepare')) {
      const exitCode = await machine.run(exercise.setupCommand);
      if (exitCode === null) {
        showResult(block, t(locale, 'lab.needsBoot'), 'muted');
        return;
      }
      resetChecks(block, exercise.checks.length);
      showResult(block, t(locale, 'lab.prepared'), 'muted');
      terminalFrame.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
      machine.focus();
      return;
    }

    if (trigger.hasAttribute('data-type-solution')) {
      machine.typeIntoShell(exercise.solutionCommand);
      return;
    }

    if (!machine.isReady()) {
      showResult(block, t(locale, 'lab.resultOffline'), 'muted');
      return;
    }

    if (!machine.isAtPrompt()) {
      showResult(block, t(locale, 'lab.resultBusy'), 'muted');
      return;
    }

    showResult(block, t(locale, 'lab.checking'), 'muted');
    const passed = await runChecks(block, exercise);
    if (passed === null) {
      showResult(block, t(locale, 'lab.resultBusy'), 'muted');
      return;
    }

    if (passed === exercise.checks.length) {
      progress = { ...progress, [exercise.id]: true };
      saveLabProgress(progress);
      renderProgress();
      showResult(block, t(locale, 'lab.resultPassed'), 'positive');
      return;
    }

    showResult(block, t(locale, 'lab.resultPartial')(passed, exercise.checks.length), 'negative');
  });

  let resizeTimer = 0;
  window.addEventListener('resize', () => {
    window.clearTimeout(resizeTimer);
    resizeTimer = window.setTimeout(() => machine.fitToContainer(), 200);
  });

  renderProgress();
</script>
