---
import type { Locale } from '../i18n/languages';
import { t } from '../i18n/ui';
import { LAB_TRACKS, LAB_EXERCISES } from '../lib/lab/registry';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const exercisesForTrack = (trackId: string) => LAB_EXERCISES.filter((exercise) => exercise.track === trackId);
---

<div data-lab data-locale={locale} class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] lg:items-start">
  <section class="surface order-1 flex min-w-0 flex-col gap-3 p-4 lg:sticky lg:top-20 lg:order-2">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <p class="eyebrow" data-machine-status>{t(locale, 'lab.idleTerminal')}</p>
      <div class="flex gap-2">
        <button type="button" data-boot class="chip chip-info interactive px-3 py-1.5">
          {t(locale, 'lab.boot')}
        </button>
        <button type="button" data-restart hidden class="chip chip-neutral interactive px-3 py-1.5">
          {t(locale, 'lab.restart')}
        </button>
      </div>
    </div>

    <div class="terminal-frame" data-terminal-frame>
      <p class="p-4 text-xs text-faint" data-terminal-placeholder>{t(locale, 'lab.idleTerminal')}</p>
      <div class="h-full w-full" data-terminal></div>
    </div>

    <p class="text-xs leading-relaxed text-faint">{t(locale, 'lab.about')}</p>
  </section>

  <section class="order-2 flex min-w-0 flex-col gap-8 lg:order-1">
    <div class="flex items-baseline justify-between gap-3">
      <h2 class="text-lg font-semibold text-strong">{t(locale, 'lab.exercisesHeading')}</h2>
      <p class="text-xs text-muted" data-lab-progress>{t(locale, 'lab.progress')(0, LAB_EXERCISES.length)}</p>
    </div>

    {
      LAB_TRACKS.map((track) => (
        <div class="flex flex-col gap-4">
          <div class="flex items-baseline gap-3 border-b border-hairline pb-2">
            <p class="eyebrow">LPIC-1 {track.objectiveCode}</p>
            <h3 class="text-base font-semibold text-strong">{track.title[locale]}</h3>
          </div>

          {exercisesForTrack(track.id).map((exercise) => (
            <article class="surface flex flex-col gap-3 p-5" data-exercise={exercise.id}>
              <div class="flex flex-wrap items-start justify-between gap-3">
                <h4 class="font-semibold text-strong">{exercise.title[locale]}</h4>
                <span class="chip chip-positive hidden" data-solved-badge>
                  {t(locale, 'lab.solved')}
                </span>
              </div>

              <p class="text-sm leading-relaxed text-default">{exercise.task[locale]}</p>

              <div class="flex flex-wrap gap-2">
                <button type="button" data-prepare class="chip chip-neutral interactive px-3 py-1.5">
                  {t(locale, 'lab.prepare')}
                </button>
                <button type="button" data-check class="chip chip-info interactive px-3 py-1.5">
                  {t(locale, 'lab.check')}
                </button>
              </div>

              <p class="hidden text-xs leading-relaxed" data-result />

              <details class="text-sm">
                <summary class="eyebrow cursor-pointer">{t(locale, 'lab.hint')}</summary>
                <p class="mt-2 leading-relaxed text-muted">{exercise.hint[locale]}</p>
              </details>

              <details class="text-sm">
                <summary class="eyebrow cursor-pointer">{t(locale, 'lab.solution')}</summary>
                <div class="mt-2 flex flex-col items-start gap-2">
                  <code class="surface-nested data block w-full overflow-x-auto p-3 text-xs text-default">
                    {exercise.solutionCommand}
                  </code>
                  <button type="button" data-type-solution class="chip chip-neutral interactive px-3 py-1.5">
                    {t(locale, 'lab.typeSolution')}
                  </button>
                </div>
              </details>
            </article>
          ))}
        </div>
      ))
    }
  </section>
</div>

<style>
  .terminal-frame {
    background-color: #fbfbfb;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-md);
    height: 26rem;
    overflow: hidden;
    padding: 0.5rem;
  }
</style>

<script>
  import '@xterm/xterm/css/xterm.css';
  import { LabMachine, type MachineStatus } from '../lib/lab/machine';
  import { LAB_EXERCISES } from '../lib/lab/registry';
  import { loadLabProgress, saveLabProgress } from '../lib/lab/progress';
  import { t } from '../i18n/ui';
  import type { Locale } from '../i18n/languages';

  const root = document.querySelector<HTMLElement>('[data-lab]')!;
  const locale = root.dataset.locale as Locale;

  const statusLabel = root.querySelector<HTMLElement>('[data-machine-status]')!;
  const bootButton = root.querySelector<HTMLButtonElement>('[data-boot]')!;
  const restartButton = root.querySelector<HTMLButtonElement>('[data-restart]')!;
  const terminalFrame = root.querySelector<HTMLElement>('[data-terminal-frame]')!;
  const terminalContainer = root.querySelector<HTMLElement>('[data-terminal]')!;
  const placeholder = root.querySelector<HTMLElement>('[data-terminal-placeholder]')!;
  const progressLabel = root.querySelector<HTMLElement>('[data-lab-progress]')!;

  let progress = loadLabProgress();

  const findExercise = (id: string) => LAB_EXERCISES.find((exercise) => exercise.id === id)!;

  const showStatus = (status: MachineStatus) => {
    if (status === 'booting') statusLabel.textContent = t(locale, 'lab.booting');
    if (status === 'ready') {
      statusLabel.textContent = t(locale, 'lab.ready');
      restartButton.hidden = false;
    }
  };

  const machine = new LabMachine({
    assetsPath: `${import.meta.env.BASE_URL}/lab`,
    terminalContainer,
    banner: t(locale, 'lab.terminalBanner'),
    onStatusChange: showStatus,
    onDownloadProgress: (percent) => {
      statusLabel.textContent = t(locale, 'lab.downloading')(percent);
    },
  });

  const renderProgress = () => {
    const solved = LAB_EXERCISES.filter((exercise) => progress[exercise.id]).length;
    progressLabel.textContent = t(locale, 'lab.progress')(solved, LAB_EXERCISES.length);

    LAB_EXERCISES.forEach((exercise) => {
      const badge = root.querySelector<HTMLElement>(`[data-exercise="${exercise.id}"] [data-solved-badge]`);
      badge?.classList.toggle('hidden', !progress[exercise.id]);
    });
  };

  const resultTones = {
    positive: 'text-xs leading-relaxed text-positive',
    negative: 'text-xs leading-relaxed text-negative',
    muted: 'text-xs leading-relaxed text-muted',
  };

  const showResult = (block: HTMLElement, message: string, tone: keyof typeof resultTones) => {
    const result = block.querySelector<HTMLElement>('[data-result]')!;
    result.textContent = message;
    result.className = resultTones[tone];
  };

  bootButton.addEventListener('click', async () => {
    bootButton.disabled = true;
    placeholder.hidden = true;
    await machine.boot();
    bootButton.hidden = true;
    machine.focus();
  });

  restartButton.addEventListener('click', () => machine.restart());

  root.addEventListener('click', async (event) => {
    const trigger = (event.target as HTMLElement).closest<HTMLElement>(
      '[data-prepare], [data-check], [data-type-solution]',
    );
    if (!trigger) return;

    const block = trigger.closest<HTMLElement>('[data-exercise]')!;
    const exercise = findExercise(block.dataset.exercise!);

    if (trigger.hasAttribute('data-prepare')) {
      const exitCode = await machine.run(exercise.setupCommand);
      if (exitCode === null) {
        showResult(block, t(locale, 'lab.needsBoot'), 'muted');
        return;
      }
      showResult(block, t(locale, 'lab.prepared'), 'muted');
      terminalFrame.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
      machine.focus();
      return;
    }

    if (trigger.hasAttribute('data-type-solution')) {
      machine.typeIntoShell(exercise.solutionCommand);
      return;
    }

    if (!machine.isReady()) {
      showResult(block, t(locale, 'lab.resultOffline'), 'muted');
      return;
    }

    if (!machine.isAtPrompt()) {
      showResult(block, t(locale, 'lab.resultBusy'), 'muted');
      return;
    }

    const exitCode = await machine.run(exercise.checkCommand);
    if (exitCode === null) {
      showResult(block, t(locale, 'lab.resultBusy'), 'muted');
      return;
    }

    if (exitCode === 0) {
      progress = { ...progress, [exercise.id]: true };
      saveLabProgress(progress);
      renderProgress();
      showResult(block, t(locale, 'lab.resultPassed'), 'positive');
      return;
    }

    showResult(block, t(locale, 'lab.resultFailed'), 'negative');
  });

  let resizeTimer = 0;
  window.addEventListener('resize', () => {
    window.clearTimeout(resizeTimer);
    resizeTimer = window.setTimeout(() => machine.fitToContainer(), 200);
  });

  renderProgress();
</script>
