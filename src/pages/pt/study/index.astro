---
import Layout from '../../../layouts/Layout.astro';
import StudyMode from '../../../components/StudyMode.astro';
import { t } from '../../../i18n/ui';

const locale = 'pt' as const;
---

<Layout locale={locale} title={t(locale, 'study.title')}>
  <div class="motion-rise flex flex-col gap-3">
    <p class="display text-2xl md:text-3xl">{t(locale, 'study.title')}</p>
    <p class="text-base text-muted">{t(locale, 'study.tagline')}</p>
  </div>

  <div class="motion-rise stagger-1 mt-10">
    <StudyMode locale={locale} />
  </div>
</Layout>
