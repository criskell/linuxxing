---
import Layout from '../../layouts/Layout.astro';
import Explainer from '../../components/Explainer.astro';
import { t } from '../../i18n/ui';

const locale = 'pt' as const;
---

<Layout locale={locale}>
  <p class="motion-rise display text-2xl md:text-3xl">{t(locale, 'site.tagline')}</p>

  <div class="motion-rise stagger-1 mt-10">
    <Explainer locale={locale} />
  </div>
</Layout>
