---
import Layout from '../../layouts/Layout.astro';
import Explainer from '../../components/Explainer.astro';
import { t } from '../../i18n/ui';

const locale = 'en' as const;
---

<Layout locale={locale}>
  <p class="motion-rise text-base text-muted">{t(locale, 'site.tagline')}</p>

  <div class="motion-rise stagger-1 mt-10">
    <Explainer locale={locale} />
  </div>
</Layout>
